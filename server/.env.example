# Required: Encryption key for secrets (32 bytes hex, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
APP_SECRET_KEY=your_32_byte_hex_key_here

# Required: JWT secret for session tokens
JWT_SECRET=your_jwt_secret_here

# Required: Workspace password for login
WORKSPACE_PASSWORD=your_secure_password_here

# Server configuration
PORT=3001
NODE_ENV=development

# Optional: Default credentials (can be set via UI instead)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
MONGODB_URI=

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK Configuration (Optional)
# Option 1: Use service account JSON file path (recommended for local development)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2: Use individual credentials (recommended for production/cloud deployment)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
