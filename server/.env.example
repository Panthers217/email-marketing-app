# Required: Encryption key for secrets (32 bytes hex, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
APP_SECRET_KEY=your_32_byte_hex_key_here

# Required: JWT secret for session tokens
JWT_SECRET=your_jwt_secret_here

# Required: Workspace password for login
WORKSPACE_PASSWORD=your_secure_password_here

# Server configuration
PORT=3001
NODE_ENV=development

# Optional: Default credentials (can be set via UI instead)
RESEND_API_KEY=
MONGODB_URI=

# Client URL for CORS
CLIENT_URL=http://localhost:5173
